# Runtime. TRIALMATCH_ENV is documentary in the current prototype.
TRIALMATCH_ENV=development
# Loaded from this repository-root file for backend development. An already-exported
# process value takes precedence. PostgreSQL example (use real secrets only in .env):
# TRIALMATCH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
TRIALMATCH_DATABASE_URL=sqlite:///./backend/data/trialmatch.sqlite3
TRIALMATCH_SITE_EXPORT_PATH=backend/data/exports/ma_trial_sites.json

# Server-only Next.js backend URL. Set this in Vercel production.
TRIALMATCH_API_BASE_URL=http://localhost:8000

# Browser-visible direct API URL. Use only for local/direct-browser development;
# leave unset in production so same-origin Next.js proxies are used.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ClinicalTrials.gov ingestion
CLINICALTRIALS_API_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_REQUEST_TIMEOUT_SECONDS=30
CLINICALTRIALS_MAX_RETRIES=3
CLINICALTRIALS_CACHE_DIR=backend/data/cache/clinicaltrials

# MassGIS acquisition. Production request paths use committed validated snapshots;
# these values document the source but are not runtime router settings.
MASSGIS_EJ_QUERY_URL=https://arcgisserver.digital.mass.gov/arcgisserver/rest/services/AGOL/EJ2020/MapServer/0/query
MASSGIS_REQUEST_TIMEOUT_SECONDS=30

# Optional backend-only LLM integration. Keep disabled unless a bounded run is approved.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
